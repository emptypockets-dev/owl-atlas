{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": true,
  "buildCommand": "npm run build:deploy",
  "outputDirectory": "dist",
  "installCommand": "",
  "headers": [
    {
      "source": "/public/images/derived/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
