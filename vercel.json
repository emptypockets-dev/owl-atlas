{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": true,
  "buildCommand": "npm run build:deploy",
  "outputDirectory": "dist",
  "installCommand": "",
  "redirects": [
    { "source": "/kit", "destination": "/atlas/#sources", "statusCode": 308 },
    { "source": "/kit/", "destination": "/atlas/#sources", "statusCode": 308 },
    { "source": "/kit/:path*", "destination": "/atlas/#sources", "statusCode": 308 }
  ],
  "headers": [
    {
      "source": "/public/images/derived/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
